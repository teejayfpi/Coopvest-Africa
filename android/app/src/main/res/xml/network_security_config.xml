<?xml version="1.0" encoding="utf-8"?>
<!--
  Release / main network policy: cleartext HTTP is denied everywhere.

  Production traffic (Render, Supabase, Paystack, Firebase) is HTTPS, so this
  is the correct default. A debug-only override at
  src/debug/res/xml/network_security_config.xml re-permits the local dev hosts
  so `flutter run` against a machine-hosted backend still works.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
