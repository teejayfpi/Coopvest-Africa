<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
        <!-- Push notifications (Firebase Cloud Messaging) for Release/Profile.

             `production` is required for TestFlight and App Store builds. With
             `development` here, APNs issues a sandbox token that the production
             APNs environment cannot deliver to, so TestFlight/App Store pushes
             silently reach nobody. Debug keeps Runner.entitlements, which uses
             `development` so local builds still receive pushes. -->
        <key>aps-environment</key>
        <string>production</string>
</dict>
</plist>
